{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content.call.schema.json",
  "title": "MsgLayer Call Content",
  "type": "object",
  "required": [
    "duration_sec",
    "call_type"
  ],
  "properties": {
    "duration_sec": {
      "type": "integer",
      "minimum": 0
    },
    "call_type": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing",
        "missed",
        "rejected",
        "voicemail",
        "unknown"
      ]
    },
    "recording": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
