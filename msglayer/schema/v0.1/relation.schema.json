{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "relation.schema.json",
  "title": "MsgLayer Relation",
  "type": "object",
  "required": [
    "type",
    "target"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "same_thread",
        "reply_to",
        "derived_from",
        "references_identity"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
